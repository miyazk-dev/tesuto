---
import BaseLayout from '../layouts/BaseLayout.astro'; import { products } from '../data/content';
---
<BaseLayout title="自社プロダクト"><section class="container page-hero"><div class="eyebrow">Products</div><h1 class="page-title">自社プロダクト</h1><p>企画・開発中のサービスをご紹介します。</p></section><section class="container section">{products.filter(p=>p.status==='公開中').length ? <div class="grid">{products.filter(p=>p.status==='公開中').map(p=><article class="card"><span class="eyebrow">公開中</span><h2>{p.name}</h2><p>{p.description}</p>{p.url&&<a class="text-link" href={p.url}>プロダクトを見る →</a>}</article>)}</div> : <div class="product-empty"><h2>現在準備中</h2><p class="muted">公開中のプロダクトはありません。公開できるサービスが整い次第、こちらでご案内します。</p></div>}</section></BaseLayout>
